# Copy this file to .env and fill in the values from your Supabase project.
# Dashboard: Project Settings -> API
#
# Both variables are VITE_-prefixed, which means Vite inlines them into the
# browser bundle. Never put a secret in a VITE_ variable.

# VITE_SUPABASE_URL: Your project's REST endpoint, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# VITE_SUPABASE_ANON_KEY: The public anon key. Safe to expose in the client -
# it is constrained by Row Level Security, so your policies are what protect
# your data. Do NOT use the service_role key here; it bypasses RLS entirely.
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# DISABLE_HMR (optional): set to "true" to turn off hot module replacement.
# DISABLE_HMR="true"

# ---------------------------------------------------------------------------
# Server-side secrets are NOT set here.
#
# The Korusa AI messaging tools run in the korusa-ai edge function, which reads
# its secrets from Supabase's secret store so they never reach the browser:
#
#   supabase secrets set AI_API_URL="..." AI_API_KEY="..." AI_MODEL="..."
#
# Or via the dashboard: Edge Functions -> Manage secrets.
# ---------------------------------------------------------------------------
